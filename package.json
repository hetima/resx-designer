{
  "name": "resx-designer",
  "displayName": "resx-designer",
  "publisher": "hetima",
  "description": "Seamlessly Display and Edit RESX Files — Multi-language resource editor",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hetima/resx-designer.git"
  },
  "version": "0.1.1",
  "engines": {
    "vscode": "^1.120.0",
    "node": ">=14"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "resx",
        "extensions": [
          ".resx"
        ],
        "aliases": [
          "RESX",
          "resx"
        ],
        "firstLine": "^\\s*<\\?xml\\b",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "resx",
        "scopeName": "text.xml",
        "path": "./xml.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "resx.toggleExtension",
        "title": "RESX: Toggle Extension On/Off"
      },
      {
        "command": "resx.changeFontFamily",
        "title": "RESX: Change Font Family"
      },
      {
        "command": "resx.addLocale",
        "title": "RESX: Add New Locale"
      },
      {
        "command": "resx.refreshLocales",
        "title": "RESX: Refresh Locale Files"
      },
      {
        "command": "resx.sortByName",
        "title": "RESX: Sort Entries by Name"
      },
      {
        "command": "resx.sortDefaultFileKeys",
        "title": "RESX: Sort Default File Keys"
      },
      {
        "command": "resx.sortAllFileKeys",
        "title": "RESX: Sort All File Keys"
      },
      {
        "command": "resx.debugClearState",
        "title": "RESX: Debug Clear Workspace State"
      },
      {
        "command": "resx.setDefaultResx",
        "title": "RESX: Set as Default resx"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "resx-designer",
      "properties": {
        "resx.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/Disable the RESX custom editor."
        },
        "resx.fontFamily": {
          "type": "string",
          "default": "",
          "description": "Font family used by the RESX custom editor. Leave empty to inherit 'editor.fontFamily'.",
          "scope": "application"
        },
        "resx.fontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Font size in pixels for the RESX custom editor. Set to 0 to inherit 'editor.fontSize'.",
          "scope": "application"
        },
        "resx.mouseWheelZoom": {
          "type": "boolean",
          "default": true,
          "description": "Enable Ctrl/Cmd + mouse wheel zoom in the RESX editor.",
          "scope": "application"
        },
        "resx.mouseWheelZoomInvert": {
          "type": "boolean",
          "default": false,
          "description": "Invert the Ctrl/Cmd + mouse wheel zoom direction in the RESX editor.",
          "scope": "application"
        },
        "resx.cellPadding": {
          "type": "number",
          "default": 4,
          "description": "Vertical padding in pixels for table cells."
        },
        "resx.highlightMissingTranslations": {
          "type": "boolean",
          "default": true,
          "description": "Highlight cells where the translation matches the default value or is empty (indicating untranslated entries)."
        },
        "resx.showSerialIndex": {
          "type": "boolean",
          "default": true,
          "description": "Show a serial index column (#) on the left side of the table."
        },
        "resx.singleClickEdit": {
          "type": "boolean",
          "default": false,
          "description": "Start editing a cell on single click instead of requiring Enter or double-click."
        },
        "resx.maxFileSizeMB": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "Soft max size in MB for opening files in RESX view. 0 disables the limit."
        },
        "resx.defaultResx": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          },
          "description": "Path relative to workspace root of the .resx file(s) that trigger Designer.cs generation on save. Accepts a single path or an array of paths. Falls back to any file named Strings.resx when unconfigured.",
          "scope": "resource"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "resx.editor",
        "displayName": "RESX",
        "selector": [
          {
            "filenamePattern": "*.resx"
          }
        ]
      },
      {
        "viewType": "resx.bulkEdit",
        "displayName": "RESX Bulk Edit",
        "selector": [
          {
            "filenamePattern": "*.resxbulk"
          }
        ]
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "resx.setDefaultResx",
          "when": "resourceLangId == resx",
          "group": "9_resx@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "resx.setDefaultResx",
          "when": "resourceLangId == resx",
          "group": "9_resx@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "vscode:prepublish": "npm run compile",
    "lint": "eslint '**/*.ts'",
    "package": "vsce package",
    "test": "npm run compile && node --test out/test",
    "build:webview": "esbuild src/webview/main.js --bundle --outfile=media/main.js --minify --sourcemap",
    "watch:webview": "esbuild src/webview/main.js --bundle --outfile=media/main.js --sourcemap --watch"

  },
  "dependencies": {
    "font-list": "^1.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/vscode": "^1.70.0",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.0",
    "typescript": "^4.4.3",
    "vscode": "^1.1.37"
  }
}
